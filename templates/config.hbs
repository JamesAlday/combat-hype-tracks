<div>
    <div class="form-group">
        <label>Enable Combat Hype Tracks</label>
        <input
            type="checkbox"
            name="enabled"
            {{checked enabled}}
        >
    </div>

    <div class="form-group">
        <label>Enable Debug</label>
        <input
            type="checkbox"
            name="debug"
            {{checked debug}}
        >
    </div>

    <hr>

    {{#each actors}}

        <div class="form-group hype-player">
            <label class="hype-player-name">{{name}}</label>

            <div class="form-fields hype-track-row">
                <input
                    type="text"
                    name="track-{{id}}"
                    value="{{track}}"
                    placeholder="Audio file path..."
                >

                <button
                    type="button"
                    class="file-picker"
                    data-target="track-{{id}}"
                    title="Select audio file"
                >
                    <i class="fas fa-file-audio"></i>
                </button>

                <button
                    type="button"
                    class="remove-player"
                    data-actor-id="{{id}}"
                    title="Remove Player"
                >
                    <i class="fas fa-trash"></i>
                </button>
            </div>

            <div class="hype-volume-row">
                <label for="volume-{{id}}">Volume</label>

                <input
                    type="range"
                    id="volume-{{id}}-slider"
                    name="volume-{{id}}-slider"
                    class="volume-slider"
                    value="{{volume}}"
                    data-target="volume-{{id}}"
                    min="0"
                    max="1"
                    step="0.05"
                >

                <input
                    type="number"
                    class="volume-number"
                    id="volume-{{id}}"
                    name="volume-{{id}}"
                    value="{{volume}}"
                    min="0"
                    max="1"
                    step="0.05"
                >
            </div>
        </div>

    {{/each}}

    {{#if availableActors.length}}
        <hr>

        <div class="form-group">
            <label>Add Player</label>

            <div class="form-fields">
                <select name="add-player">
                    <option value="">--Select Player--</option>

                    {{#each availableActors}}
                        <option value="{{id}}">{{name}}</option>
                    {{/each}}
                </select>

                <button
                    type="button"
                    class="add-player"
                    title="Add Player"
                >
                    <i class="fas fa-plus"></i>
                </button>
            </div>
        </div>
    {{/if}}

    <button type="submit">
        <i class="fas fa-save"></i>
        Save
    </button>
</div>